{
  "opencollection": "1.0.0",
  "info": {
    "name": "Kion Cloud Operations Accounts App Configuration API",
    "version": "3.10.0"
  },
  "request": {
    "auth": {
      "type": "bearer",
      "token": "{{bearerToken}}"
    }
  },
  "items": [
    {
      "info": {
        "name": "App Configuration",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Kion Get application configuration",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://{kion-instance}/api/v3/app-config"
          },
          "docs": "Returns the Kion application configuration settings."
        },
        {
          "info": {
            "name": "Kion Update application configuration",
            "type": "http"
          },
          "http": {
            "method": "PATCH",
            "url": "https://{kion-instance}/api/v3/app-config",
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Updates the Kion application configuration settings."
        }
      ]
    }
  ],
  "bundled": true
}